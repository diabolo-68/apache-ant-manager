{
  "name": "apache-ant-manager",
  "displayName": "Apache Ant Manager",
  "description": "Configure and manage Apache Ant tasks with a graphical UI similar to Eclipse",
  "version": "1.0.0",
  "publisher": "diabolo-68",
  "author": {
    "name": "diabolo-68"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diabolo-68/apache-ant-manager.git"
  },
  "bugs": {
    "url": "https://github.com/diabolo-68/apache-ant-manager/issues"
  },
  "homepage": "https://github.com/diabolo-68/apache-ant-manager#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/build.xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "apacheAntManager.tasks",
          "name": "Ant Tasks",
          "icon": "$(tools)",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apacheAntManager.tasks",
        "contents": "No Ant tasks yet.\nPick a build file, choose targets, and save them as a reusable VS Code task.\n[$(add) New Ant Task](command:apache-ant-manager.selectBuildFile)"
      }
    ],
    "commands": [
      {
        "command": "apache-ant-manager.openConfiguration",
        "title": "Open Task Manager",
        "category": "Ant",
        "icon": "$(list-flat)"
      },
      {
        "command": "apache-ant-manager.selectBuildFile",
        "title": "New Ant Task…",
        "category": "Ant",
        "icon": "$(add)"
      },
      {
        "command": "apache-ant-manager.createTaskFromFile",
        "title": "Create Ant Task from This File",
        "category": "Ant"
      },
      {
        "command": "apache-ant-manager.runTargets",
        "title": "Run Ant Task…",
        "category": "Ant",
        "icon": "$(play)"
      },
      {
        "command": "apache-ant-manager.rerunLastTask",
        "title": "Re-run Last Ant Task",
        "category": "Ant",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "apache-ant-manager.editTask",
        "title": "Edit Ant Task…",
        "category": "Ant",
        "icon": "$(edit)"
      },
      {
        "command": "apache-ant-manager.duplicateTask",
        "title": "Duplicate Ant Task…",
        "category": "Ant",
        "icon": "$(copy)"
      },
      {
        "command": "apache-ant-manager.deleteTask",
        "title": "Delete Ant Task…",
        "category": "Ant",
        "icon": "$(trash)"
      },
      {
        "command": "apache-ant-manager.runSingleTarget",
        "title": "Run This Target Only",
        "category": "Ant",
        "icon": "$(play)"
      },
      {
        "command": "apache-ant-manager.refresh",
        "title": "Refresh",
        "category": "Ant",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "apache-ant-manager.deleteTask",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apacheAntManager.tasks && viewItem == antTask"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .xml",
          "command": "apache-ant-manager.createTaskFromFile",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "apache-ant-manager.selectBuildFile",
          "when": "view == apacheAntManager.tasks",
          "group": "navigation@1"
        },
        {
          "command": "apache-ant-manager.refresh",
          "when": "view == apacheAntManager.tasks",
          "group": "navigation@2"
        },
        {
          "command": "apache-ant-manager.openConfiguration",
          "when": "view == apacheAntManager.tasks",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "apache-ant-manager.runTargets",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "inline@1"
        },
        {
          "command": "apache-ant-manager.editTask",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "inline@2"
        },
        {
          "command": "apache-ant-manager.runTargets",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "1_run@1"
        },
        {
          "command": "apache-ant-manager.editTask",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "2_edit@1"
        },
        {
          "command": "apache-ant-manager.duplicateTask",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "2_edit@2"
        },
        {
          "command": "apache-ant-manager.deleteTask",
          "when": "view == apacheAntManager.tasks && viewItem == antTask",
          "group": "3_delete@1"
        },
        {
          "command": "apache-ant-manager.runSingleTarget",
          "when": "view == apacheAntManager.tasks && viewItem == antTarget",
          "group": "inline@1"
        },
        {
          "command": "apache-ant-manager.runSingleTarget",
          "when": "view == apacheAntManager.tasks && viewItem == antTarget",
          "group": "1_run@1"
        }
      ],
      "commandPalette": [
        {
          "command": "apache-ant-manager.runSingleTarget",
          "when": "false"
        },
        {
          "command": "apache-ant-manager.createTaskFromFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Apache Ant Manager",
      "properties": {
        "apacheAntManager.antHome": {
          "type": "string",
          "default": "",
          "description": "Path to Apache Ant installation directory (ANT_HOME). Required if your build files use custom Ant tasks or libraries."
        },
        "apacheAntManager.javaHome": {
          "type": "string",
          "default": "",
          "description": "Path to Java installation directory (JAVA_HOME). Required if Java is not in your PATH."
        },
        "apacheAntManager.importDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum depth level for following import/include statements in build files. Set to 0 to parse only the main file. Higher values may slow down parsing."
        },
        "apacheAntManager.useJavaParser": {
          "type": "boolean",
          "default": false,
          "description": "Use the Java Ant parser instead of the fast XML parser. The Java parser resolves Ant properties but is slower and ignores the import depth limit."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.7.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^5.1.4"
  }
}
